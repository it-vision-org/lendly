POSTGRES_DB=between_three_us
POSTGRES_USER=game_user
POSTGRES_PASSWORD=your_password

DATABASE_URL=jdbc:postgresql://localhost:5432/between_three_us
DATABASE_USERNAME=game_user
DATABASE_PASSWORD=your_password

SERVER_PORT=8080

JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

# 4-6 digit PIN used to log in as each seeded player profile (change these!)
SEED_PIN_AHMED=your_pin
SEED_PIN_RAHMA=your_pin
SEED_PIN_MAMTI=your_pin

# LiveKit Cloud project (voice chat) — url + secret are server-only, never
# shipped to the Flutter app
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
